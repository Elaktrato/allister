# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[{*.sh,scripts/*}]
indent_style = tab

[*.{yml,yaml,json,js,css,html}]
indent_style = space
indent_size = 2

[*.md]
# two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false

[Dockerfile]
indent_style = space
indent_size = 2
